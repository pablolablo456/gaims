<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mini Cube Dash</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        body {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            height: 100vh;
            background-color: #121214;
            color: #ffffff;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow: hidden;
            user-select: none;
        }
        h1 {
            margin-bottom: 10px;
            font-size: 24px;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: #00ffcc;
            text-shadow: 0 0 10px rgba(0, 255, 204, 0.5);
        }
        #gameContainer {
            position: relative;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            border-radius: 4px;
            overflow: hidden;
        }
        canvas {
            background-color: #1e1e24;
            display: block;
            border: 3px solid #32323e;
        }
        .instructions {
            margin-top: 15px;
            font-size: 14px;
            color: #aaa;
            text-align: center;
        }
    </style>
</head>
<body>

    <h1>Cube Dash</h1>
    <div id="gameContainer">
        <canvas id="gameCanvas" width="800" height="400"></canvas>
    </div>
    <div class="instructions">Press <b>SPACEBAR</b> or <b>Click/Tap</b> to Jump</div>

    <script>
        const canvas = document.getElementById("gameCanvas");
        const ctx = canvas.getContext("2d");

        // Game Configuration & States
        const gravity = 0.6;
        let gameSpeed = 6;
        let score = 0;
        let highScore = 0;
        let gameOver = false;
        let obstacles = [];
        let spawnTimer = 0;

        // Player (Cube) Object
        const player = {
            x: 100,
            y: 0,
            size: 40,
            dy: 0,
            jumpStrength: -12,
            onGround: false,
            rotation: 0,
            reset: function() {
                this.y = canvas.height - this.size - 50; // 50px floor clearance
                this.dy = 0;
                this.onGround = true;
                this.rotation = 0;
            },
            update: function() {
                // Apply physics floor limitation
                const floorY = canvas.height - this.size - 50;
                
                this.dy += gravity;
                this.y += this.dy;

                if (this.y >= floorY) {
                    this.y = floorY;
                    this.dy = 0;
                    this.onGround = true;
                    // Snap rotation to nearest 90 degrees when landing
                    this.rotation = Math.round(this.rotation / (Math.PI / 2)) * (Math.PI / 2);
                } else {
                    this.onGround = false;
                    // Spin while airborne
                    this.rotation += 0.09;
                }
            },
            jump: function() {
                if (this.onGround) {
                    this.dy = this.jumpStrength;
                    this.onGround = false;
                }
            },
            draw: function() {
                ctx.save();
                // Translate context center to cube center for seamless rotation
                ctx.translate(this.x + this.size / 2, this.y + this.size / 2);
                ctx.rotate(this.rotation);
                
                // Draw Neon Cube Body
                ctx.fillStyle = "#00ffcc";
                ctx.fillRect(-this.size / 2, -this.size / 2, this.size, this.size);
                
                // Draw Inner Core Detail
                ctx.strokeStyle = "#121214";
                ctx.lineWidth = 3;
                ctx.strokeRect(-this.size / 4, -this.size / 4, this.size / 2, this.size / 2);
                
                ctx.restore();
            }
        };

        // Obstacle (Spike) Constructor
        class Obstacle {
            constructor(speed) {
                this.width = 30 + Math.random() * 15; // Variable spike width
                this.height = 40 + Math.random() * 20; // Variable spike height
                this.x = canvas.width;
                this.y = canvas.height - 50 - this.height;
                this.speed = speed;
            }
            update() {
                this.x -= this.speed;
            }
            draw() {
                ctx.fillStyle = "#ff4757";
                ctx.beginPath();
                ctx.moveTo(this.x, this.y + this.height); // Bottom left
                ctx.lineTo(this.x + this.width / 2, this.y); // Top point
                ctx.lineTo(this.x + this.width, this.y + this.height); // Bottom right
                ctx.closePath();
                ctx.fill();
            }
        }

        // Environment Layout Details
        function drawEnvironment() {
            // Draw floor line
            ctx.strokeStyle = "#57606f";
            ctx.lineWidth = 4;
            ctx.beginPath();
            ctx.moveTo(0, canvas.height - 50);
            ctx.lineTo(canvas.width, canvas.height - 50);
            ctx.stroke();

            // Draw grid lines below floor level for retro visual effect
            ctx.fillStyle = "#2f3542";
            ctx.fillRect(0, canvas.height - 48, canvas.width, 50);
        }

        function drawUI() {
            ctx.fillStyle = "#ffffff";
            ctx.font = "bold 18px 'Segoe UI'";
            ctx.fillText(`Score: ${Math.floor(score)}`, 20, 35);
            ctx.fillText(`Best: ${Math.floor(highScore)}`, 20, 60);

            if (gameOver) {
                ctx.fillStyle = "rgba(0, 0, 0, 0.75)";
                ctx.fillRect(0, 0, canvas.width, canvas.height);

                ctx.fillStyle = "#ff4757";
                ctx.font = "bold 40px 'Segoe UI'";
                ctx.textAlign = "center";
                ctx.fillText("GAME OVER", canvas.width / 2, canvas.height / 2 - 20);

                ctx.fillStyle = "#ffffff";
                ctx.font = "18px 'Segoe UI'";
                ctx.fillText("Press SPACEBAR or Click to Restart", canvas.width / 2, canvas.height / 2 + 20);
                ctx.textAlign = "left"; // reset alignment
            }
        }

        // Collision Logic using simple Axis-Aligned Bounding Box (AABB)
        function checkCollision(rect1, spike) {
            // Approximating triangle collision with tight box boundaries
            return (
                rect1.x < spike.x + spike.width &&
                rect1.x + rect1.size > spike.x &&
                rect1.y < spike.y + spike.height &&
                rect1.y + rect1.size > spike.y
            );
        }

        function init() {
            score = 0;
            gameSpeed = 6;
            obstacles = [];
            spawnTimer = 0;
            gameOver = false;
            player.reset();
        }

        // Main Engine Loop
        function gameLoop() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            drawEnvironment();
            player.update();
            player.draw();

            if (!gameOver) {
                score += 0.1;
                // Scale difficulty over time
                gameSpeed += 0.001;

                // Handle obstacle tracking and frequency management
                spawnTimer++;
                let minInterval = Math.max(50, 120 - Math.floor(gameSpeed * 2));
                if (spawnTimer > minInterval + Math.random() * 60) {
                    obstacles.push(new Obstacle(gameSpeed));
                    spawnTimer = 0;
                }

                for (let i = obstacles.length - 1; i >= 0; i--) {
                    obstacles[i].update();
                    obstacles[i].draw();

                    if (checkCollision(player, obstacles[i])) {
                        gameOver = true;
                        if (score > highScore) highScore = score;
                    }

                    // Prune off-screen obstacles
                    if (obstacles[i].x + obstacles[i].width < 0) {
                        obstacles.splice(i, 1);
                    }
                }
            }

            drawUI();
            requestAnimationFrame(gameLoop);
        }

        // Event Hookups
        function handleInput() {
            if (gameOver) {
                init();
            } else {
                player.jump();
            }
        }

        window.addEventListener("keydown", (e) => {
            if (e.code === "Space") {
                e.preventDefault();
                handleInput();
            }
        });

        canvas.addEventListener("touchstart", (e) => {
            e.preventDefault();
            handleInput();
        }, { passive: false });

        canvas.addEventListener("mousedown", (e) => {
            handleInput();
        });

        // Start Core Engine
        init();
        gameLoop();
    </script>
</body>
</html>
