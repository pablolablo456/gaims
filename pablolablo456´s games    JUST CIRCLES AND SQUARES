<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IMPOSSIBLE DODGE</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #111;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            color: #fff;
            font-family: monospace;
            overflow: hidden;
        }
        canvas {
            border: 4px solid #ff0055;
            background-color: #000;
            cursor: none;
            box-shadow: 0 0 20px rgba(255, 0, 85, 0.5);
        }
        #info {
            margin-bottom: 10px;
            font-size: 18px;
            text-align: center;
        }
    </style>
</head>
<body>

    <div id="info">
        SURVIVE THE CHAOS | Time: <span id="timeScore">0.0</span>s | High Score: <span id="highScore">0.0</span>s
    </div>
    <canvas id="gameCanvas" width="500" height="500"></canvas>

    <script>
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        const timeScoreEl = document.getElementById('timeScore');
        const highScoreEl = document.getElementById('highScore');

        let player = {
            x: canvas.width / 2,
            y: canvas.height / 2,
            size: 12
        };

        let bullets = [];
        let startTime = Date.now();
        let elapsedTime = 0;
        let highScore = 0;
        let gameOver = false;
        let spawnInterval = 400; // starts fast, gets faster
        let lastSpawn = 0;

        // Track mouse movement
        canvas.addEventListener('mousemove', (e) => {
            const rect = canvas.getBoundingClientRect();
            player.x = e.clientX - rect.left;
            player.y = e.clientY - rect.top;
        });

        function spawnBullet() {
            const side = Math.floor(Math.random() * 4);
            let x, y, vx, vy;
            const speed = 3 + Math.random() * 4 + (elapsedTime * 0.1);

            if (side === 0) { // Top
                x = Math.random() * canvas.width;
                y = -10;
                vx = (Math.random() - 0.5) * 4;
                vy = speed;
            } else if (side === 1) { // Right
                x = canvas.width + 10;
                y = Math.random() * canvas.height;
                vx = -speed;
                vy = (Math.random() - 0.5) * 4;
            } else if (side === 2) { // Bottom
                x = Math.random() * canvas.width;
                y = canvas.height + 10;
                vx = (Math.random() - 0.5) * 4;
                vy = -speed;
            } else { // Left
                x = -10;
                y = Math.random() * canvas.height;
                vx = speed;
                vy = (Math.random() - 0.5) * 4;
            }

            bullets.push({ x, y, vx, vy, size: 6 });
        }

        function resetGame() {
            bullets = [];
            startTime = Date.now();
            gameOver = false;
            player.x = canvas.width / 2;
            player.y = canvas.height / 2;
            requestAnimationFrame(gameLoop);
        }

        canvas.addEventListener('click', () => {
            if (gameOver) {
                resetGame();
            }
        });

        function gameLoop(timestamp) {
            if (gameOver) return;

            elapsedTime = ((Date.now() - startTime) / 1000).toFixed(1);
            timeScoreEl.textContent = elapsedTime;

            // Spawn bullets faster over time
            if (timestamp - lastSpawn > Math.max(80, spawnInterval - elapsedTime * 15)) {
                spawnBullet();
                lastSpawn = timestamp;
            }

            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // Draw player
            ctx.fillStyle = '#00ff66';
            ctx.fillRect(player.x - player.size / 2, player.y - player.size / 2, player.size, player.size);

            // Update and draw bullets
            ctx.fillStyle = '#ff0055';
            for (let i = bullets.length - 1; i >= 0; i--) {
                let b = bullets[i];
                b.x += b.vx;
                b.y += b.vy;

                ctx.beginPath();
                ctx.arc(b.x, b.y, b.size, 0, Math.PI * 2);
                ctx.fill();

                // Collision check (box to circle approximation)
                const distX = Math.abs(b.x - player.x);
                const distY = Math.abs(b.y - player.y);

                if (distX < (player.size / 2 + b.size) && distY < (player.size / 2 + b.size)) {
                    gameOver = true;
                    if (elapsedTime > highScore) {
                        highScore = elapsedTime;
                        highScoreEl.textContent = highScore;
                    }
                }

                // Remove off-screen bullets
                if (b.x < -50 || b.x > canvas.width + 50 || b.y < -50 || b.y > canvas.height + 50) {
                    bullets.splice(i, 1);
                }
            }

            // Game over screen
            if (gameOver) {
                ctx.fillStyle = 'rgba(0, 0, 0, 0.75)';
                ctx.fillRect(0, 0, canvas.width, canvas.height);
                ctx.fillStyle = '#ff0055';
                ctx.font = '28px monospace';
                ctx.textAlign = 'center';
                ctx.fillText('YOU DIED', canvas.width / 2, canvas.height / 2 - 20);
                ctx.fillStyle = '#fff';
                ctx.font = '16px monospace';
                ctx.fillText('Click canvas to try again', canvas.width / 2, canvas.height / 2 + 20);
                return;
            }

            requestAnimationFrame(gameLoop);
        }

        requestAnimationFrame(gameLoop);
    </script>
</body>
</html>
